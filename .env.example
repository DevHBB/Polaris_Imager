# --- avatar-imaging-pixinode spike ---------------------------------------------
# Copy to .env. Point these at the SAME hotel gamedata/assets the browser
# service uses, so both engines render identical input for a fair comparison.

# REQUIRED: where the hotel serves gamedata + .nitro assets (mirror the client's
# renderer-config.json gamedata.url / asset.url). NITRO_GAMEDATA_URL must be the
# directory that DIRECTLY contains FigureData.json / FigureMap.json /
# EffectMap.json / HabboAvatarActions.json.
NITRO_GAMEDATA_URL=https://hotel.example.com/client/gamedata
NITRO_ASSET_URL=https://hotel.example.com/client/nitro/bundled

# Optional per-file overrides (only if your layout differs), e.g. for a layout
# like http://192.168.0.8/gamedata/{config,clothes,effect}:
#   NITRO_GAMEDATA_URL=http://192.168.0.8/gamedata/config
#   NITRO_AVATAR_ASSET_URL=http://192.168.0.8/gamedata/clothes/%libname%.nitro
#   NITRO_AVATAR_ASSET_EFFECT_URL=http://192.168.0.8/gamedata/effect/%libname%.nitro
# NITRO_AVATAR_ACTIONS_URL=
# NITRO_AVATAR_FIGUREDATA_URL=
# NITRO_AVATAR_FIGUREMAP_URL=
# NITRO_AVATAR_EFFECTMAP_URL=
# NITRO_AVATAR_MANDATORY_LIBRARIES=bd:1,li:0
# NITRO_AVATAR_MANDATORY_EFFECT_LIBRARIES=dance.1,dance.2,dance.3,dance.4

# Animation playback rate for APNG output + a hard frame cap.
AVATAR_IMAGING_FPS=12
AVATAR_IMAGING_MAX_FRAMES=60

# Point the build at a specific renderer checkout instead of the yarn-link.
# NITRO_RENDERER_PATH=/path/to/Nitro-Renderer

# --- HTTP service (npm start) -------------------------------------------------
# Only used by src/server.mjs; the CLI (render.mjs) ignores these.
AVATAR_IMAGING_HOST=0.0.0.0
AVATAR_IMAGING_PORT=8082
# Per-render + boot time budgets (ms).
# AVATAR_IMAGING_RENDER_TIMEOUT_MS=30000
# AVATAR_IMAGING_BOOT_TIMEOUT_MS=60000
# Response cache (in-memory LRU keyed by the full query).
# AVATAR_IMAGING_CACHE_ENTRIES=512
# AVATAR_IMAGING_CACHE_MAX_BYTES=268435456
# AVATAR_IMAGING_CACHE_TTL_MS=300000
# Bump to invalidate clients' cached copies after regenerating gamedata/assets.
# AVATAR_IMAGING_ASSET_VERSION=
# Shed load: 503 once this many requests are already queued for the renderer.
# AVATAR_IMAGING_MAX_QUEUE=16
# Per-IP rate limit (fixed window). Set max to 0 to disable.
# AVATAR_IMAGING_RATELIMIT_WINDOW_MS=60000
# AVATAR_IMAGING_RATELIMIT_MAX=120
# Comma-separated API keys; when set, requests need ?key= or X-API-Key. Empty => public.
# AVATAR_IMAGING_API_KEYS=
# CORS allow-origin for /avatarimage (e.g. https://cms.example or *). Empty => none.
# AVATAR_IMAGING_CORS_ORIGIN=
# Behind a reverse proxy: "true", a hop count, or a subnet; + the real-IP header.
# AVATAR_IMAGING_TRUST_PROXY=true
# AVATAR_IMAGING_CLIENT_IP_HEADER=x-forwarded-for
# Access log to a rotating file instead of stdout.
# AVATAR_IMAGING_LOG_FILE=/var/log/avatar-imaging-pixinode/access.log
# Verbose per-render effect diagnostics.
# AVATAR_IMAGING_DEBUG=0

# Speech-bubble font. node-canvas has no bundled fonts, so text (?text=...) is
# rendered with whatever is registered as "Arial". By default node-env auto-scans
# the standard Linux (Liberation/DejaVu), Windows (C:\Windows\Fonts\arial.ttf) and
# macOS Arial paths — so on Linux `apt-get install fonts-liberation` is enough, and
# Windows/macOS work out of the box. Point these at a specific .ttf for
# byte-identical text across machines (e.g. a real Arial you provide).
# AVATAR_IMAGING_FONT_FILE=/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf
# AVATAR_IMAGING_FONT_FILE_BOLD=/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf

# --- [EN] Avatar generator UI (GET /Generate) ---------------------------------
# --- [FR] Interface du générateur d'avatars (GET /Generate) -------------------
# [EN] Browser page to build a figure and copy/download the image. Enabled by
#      default; set to 0 to serve only the raw /avatarimage API.
# [FR] Page navigateur pour composer une figure et copier/télécharger l'image.
#      Activée par défaut ; mettre 0 pour ne servir que l'API /avatarimage brute.
AVATAR_IMAGING_GENERATE_UI=1
# [EN] Path and title of the page. [FR] Chemin et titre de la page.
AVATAR_IMAGING_GENERATE_PATH=/Generate
AVATAR_IMAGING_GENERATE_TITLE=Avatar Studio
# [EN] Public base URL of this service, no trailing slash. Leave empty to use
#      same-origin relative URLs (works out of the box behind any proxy).
# [FR] URL publique de base de ce service, sans slash final. Laisser vide pour
#      des URLs relatives de même origine (fonctionne d'emblée derrière un proxy).
# AVATAR_IMAGING_PUBLIC_URL=https://avatar.mon-hotel.fr
# [EN] Require ?token=... to open the page. Empty => the page is public.
# [FR] Exige ?token=... pour ouvrir la page. Vide => la page est publique.
# AVATAR_IMAGING_GENERATE_TOKEN=
# [EN] Only needed if AVATAR_IMAGING_API_KEYS is set: key the page appends to
#      image URLs. It is visible in the HTML, so use a dedicated key.
# [FR] Utile seulement si AVATAR_IMAGING_API_KEYS est défini : clé que la page
#      ajoute aux URLs d'images. Elle est visible dans le HTML : utilisez une
#      clé dédiée.
# AVATAR_IMAGING_GENERATE_KEY=
# [EN] Figure pre-filled when the page opens with no ?figure=.
# [FR] Figure pré-remplie quand la page s'ouvre sans ?figure=.
# AVATAR_IMAGING_DEFAULT_FIGURE=hd-180-1.ch-255-66.lg-280-110.sh-305-62

# --- [EN] Panel login (optional) / [FR] Connexion au panel (optionnelle) ------
# [EN] false (default) => the panel is public, like the /avatarimage API.
# [FR] false (défaut) => le panel est public, comme l'API /avatarimage.
AVATAR_IMAGING_GENERATE_AUTH=false

# [EN] Two modes:
#   password (default) — one shared account defined below. No database needed,
#                        no player account exposed, works even if MySQL is down.
#   hotel              — sign in with a REAL hotel account, checked against the
#                        users table, with a minimum rank. Requires
#                        AVATAR_IMAGING_DB_ENABLED=true.
# [FR] Deux modes :
#   password (défaut) — un compte partagé défini ci-dessous. Aucune base
#                       nécessaire, aucun compte joueur exposé, fonctionne même
#                       si MySQL est à l'arrêt.
#   hotel             — connexion avec un VRAI compte de l'hôtel, vérifié dans
#                       la table des utilisateurs, avec un rang minimum.
#                       Nécessite AVATAR_IMAGING_DB_ENABLED=true.
AVATAR_IMAGING_GENERATE_AUTH_MODE=password

# [EN] Mode "password" only. Leave the user empty for a password-only form.
# [FR] Mode « password » uniquement. Laisser l'identifiant vide pour un
#      formulaire mot de passe seul.
AVATAR_IMAGING_GENERATE_USER=admin
AVATAR_IMAGING_GENERATE_PASSWORD=

# [EN] Mode "hotel" only: minimum rank allowed into the panel.
# [FR] Mode « hotel » uniquement : rang minimum autorisé dans le panel.
AVATAR_IMAGING_GENERATE_MIN_RANK=6

# [EN] Signing secret for the session cookie (any long random string). Empty =>
#      a new one at every restart, which logs everyone out.
# [FR] Secret de signature du cookie de session (n'importe quelle longue chaîne
#      aléatoire). Vide => un nouveau à chaque redémarrage, ce qui déconnecte
#      tout le monde.
# AVATAR_IMAGING_GENERATE_SECRET=
# AVATAR_IMAGING_GENERATE_SESSION_MS=43200000
# [EN] Brute-force guard: failures allowed per IP, then lockout duration.
# [FR] Garde anti-force brute : échecs autorisés par IP, puis durée de blocage.
# AVATAR_IMAGING_GENERATE_MAX_ATTEMPTS=8
# AVATAR_IMAGING_GENERATE_LOCK_MS=900000

# --- [EN] Hotel database (optional) / [FR] Base de l'hôtel (optionnelle) ------
# [EN] false (default) => the service NEVER connects to any database, and the
#      panel only offers avatar creation (no username search).
#      true            => the panel can search players. Used only by the panel,
#      and only for SELECT on the users table: a read-only MySQL account is
#      enough. It must be set to true AND the user/name filled in below.
# [FR] false (défaut) => le service ne se connecte JAMAIS à une base, et le
#      panel ne propose que la création d'avatars (pas de recherche par pseudo).
#      true            => le panel peut rechercher des joueurs. Utilisée
#      uniquement par le panel, et uniquement en SELECT sur la table des
#      utilisateurs : un compte MySQL en lecture seule suffit. Doit être à true
#      ET avec l'utilisateur/le nom renseignés ci-dessous.
AVATAR_IMAGING_DB_ENABLED=false
AVATAR_IMAGING_DB_HOST=127.0.0.1
AVATAR_IMAGING_DB_PORT=3306
AVATAR_IMAGING_DB_NAME=habbo
AVATAR_IMAGING_DB_USER=
AVATAR_IMAGING_DB_PASSWORD=
# [EN] Only if your emulator's schema differs (Polaris/Arcturus: users.look).
# [FR] Seulement si le schéma de votre émulateur diffère (Polaris/Arcturus : users.look).
# AVATAR_IMAGING_DB_TABLE=users
# AVATAR_IMAGING_DB_USERNAME_COLUMN=username
# AVATAR_IMAGING_DB_LOOK_COLUMN=look
# [EN] Read ONLY in auth mode "hotel". Never selected otherwise.
# [FR] Lues UNIQUEMENT en mode d'authentification « hotel ». Jamais
#      sélectionnées autrement.
# AVATAR_IMAGING_DB_PASSWORD_COLUMN=password
# AVATAR_IMAGING_DB_RANK_COLUMN=rank

# [EN] Alternative to the database, when AVATAR_IMAGING_DB_ENABLED=false: any URL
#      on your own site that answers {"figure":"hd-180-1..."} for a username.
#      It provides the "Charger" button (no live suggestions, those need the DB).
#      Ignored when the database above is enabled. Empty => no search at all.
# [FR] Alternative à la base, quand AVATAR_IMAGING_DB_ENABLED=false : n'importe
#      quelle URL de votre site répondant {"figure":"hd-180-1..."} pour un pseudo.
#      Elle fournit le bouton « Charger » (pas les suggestions en direct, qui
#      nécessitent la base). Ignorée si la base ci-dessus est activée. Vide =>
#      aucune recherche.
# AVATAR_IMAGING_LOOKUP_URL=https://mon-hotel.fr/api/look?username=%username%
# AVATAR_IMAGING_LOOKUP_HEADER=X-API-Key
# AVATAR_IMAGING_LOOKUP_KEY=

# [EN] The generator loads ~17 images per preview refresh, so keep the image
#      rate limit generous when the UI is enabled.
# [FR] Le générateur charge ~17 images par rafraîchissement d'aperçu : gardez
#      une limite de requêtes généreuse quand l'interface est activée.
AVATAR_IMAGING_RATELIMIT_MAX=600
